---
import SectionHeading from './SectionHeading.astro';
import type { Lang } from '../i18n/langs';
import { useTranslations } from '../i18n/t';
import { diagramNodes } from '../content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const DEFAULT = 'btp';
---

<section id="arquitetura" class="section grid-bg">
  <div class="container-x">
    <SectionHeading
      eyebrow={t('arch.eyebrow')}
      title={t('arch.title')}
      highlight={t('arch.highlight')}
      sub={t('arch.sub')}
    />
    <p class="sr-only">{t('arch.srDescription')}</p>

    <div class="diagram" data-diagram data-reveal>
      {
        diagramNodes.map((node, i) => (
          <>
            {i > 0 && <span class="wire" aria-hidden="true" />}
            <button
              type="button"
              data-node={node.id}
              aria-controls={`painel-${node.id}`}
              aria-pressed={node.id === DEFAULT ? 'true' : 'false'}
              class:list={['node glass', { core: node.core }]}
            >
              <span class="badge">{node.badge}</span>
              <span class="block font-display text-[0.95rem] font-semibold">{node.title[lang]}</span>
              <span class="mt-1 block text-xs leading-snug text-muted">{node.subtitle[lang]}</span>
            </button>
          </>
        ))
      }
    </div>

    <p class="mt-6 text-center text-xs text-muted" aria-hidden="true">{t('arch.hint')}</p>

    {
      diagramNodes.map((node) => (
        <div
          id={`painel-${node.id}`}
          data-panel={node.id}
          role="region"
          aria-label={node.panelTitle[lang]}
          hidden={node.id !== DEFAULT}
          class="glass mt-4 grid gap-4 border-primary/30 bg-surface/60 p-5 sm:grid-cols-[auto_1fr]"
        >
          <span class="badge solid">{node.badge}</span>
          <div>
            <h3 class="font-display text-base font-semibold">{node.panelTitle[lang]}</h3>
            <ul class="mt-2 space-y-1 text-sm text-[#c3d4ec]">
              {node.bullets[lang].map((b) => (
                <li class="flex gap-2">
                  <span class="mt-2 size-1 shrink-0 rounded-full bg-cyan" />
                  {b}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .diagram {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    justify-items: stretch;
  }

  @media (min-width: 900px) {
    .diagram {
      grid-template-columns: 1fr 56px 1.15fr 56px 1fr 56px 1fr;
      align-items: center;
    }
  }

  .node {
    padding: 1rem;
    text-align: center;
    cursor: pointer;
    transition:
      transform 0.25s,
      border-color 0.25s,
      box-shadow 0.25s;
  }

  .node:hover,
  .node[aria-pressed='true'] {
    border-color: var(--color-primary);
    box-shadow:
      0 0 0 1px var(--color-primary),
      0 0 30px rgb(59 156 255 / 0.35);
    transform: translateY(-3px);
  }

  .node.core {
    background: linear-gradient(160deg, rgb(59 156 255 / 0.16), rgb(139 92 246 / 0.16));
    border-color: rgb(139 92 246 / 0.5);
  }

  .badge {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: 0 auto 0.6rem;
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: linear-gradient(135deg, rgb(59 156 255 / 0.3), rgb(139 92 246 / 0.3));
  }

  .badge.solid {
    margin: 0;
    background: linear-gradient(135deg, #1f6fd1, #6d3fe0);
  }

  .wire {
    position: relative;
    justify-self: center;
    width: 2px;
    height: 36px;
    background: rgb(127 184 255 / 0.25);
  }

  @media (min-width: 900px) {
    .wire {
      justify-self: stretch;
      width: auto;
      height: 2px;
    }
  }

  .wire::before,
  .wire::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    left: -3px;
    top: 0;
    opacity: 0;
  }

  .wire::before {
    background: var(--color-cyan);
    box-shadow: 0 0 10px var(--color-cyan);
  }

  .wire::after {
    background: #a78bfa;
    box-shadow: 0 0 10px #a78bfa;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .wire::before {
      animation: flow-down 2.2s linear infinite;
    }

    :global(.js) .wire::after {
      animation: flow-up 2.2s linear infinite 1.1s;
    }

    @media (min-width: 900px) {
      :global(.js) .wire::before {
        animation-name: flow-right;
      }

      :global(.js) .wire::after {
        animation-name: flow-left;
      }
    }
  }

  @keyframes flow-down {
    from { top: 0; opacity: 1; }
    to { top: calc(100% - 8px); opacity: 1; }
  }

  @keyframes flow-up {
    from { top: calc(100% - 8px); opacity: 1; }
    to { top: 0; opacity: 1; }
  }

  @keyframes flow-right {
    from { left: 0; top: -3px; opacity: 1; }
    to { left: calc(100% - 8px); top: -3px; opacity: 1; }
  }

  @keyframes flow-left {
    from { left: calc(100% - 8px); top: -3px; opacity: 1; }
    to { left: 0; top: -3px; opacity: 1; }
  }
</style>

<script>
  import '../scripts/diagram';
</script>
