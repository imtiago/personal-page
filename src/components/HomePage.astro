---
import About from './About.astro';
import Certifications from './Certifications.astro';
import ConnectDiagram from './ConnectDiagram.astro';
import Contact from './Contact.astro';
import Expertise from './Expertise.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import LangSuggest from './LangSuggest.astro';
import Nav from './Nav.astro';
import Process from './Process.astro';
import Projects from './Projects.astro';
import Testimonials from './Testimonials.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import type { Lang } from '../i18n/langs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="conteudo" data-lang={lang}>
  <Hero lang={lang} />
  <Expertise lang={lang} />
  <ConnectDiagram lang={lang} />
  <Process lang={lang} />
  <Projects lang={lang} />
  <Certifications lang={lang} />
  <Testimonials lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} />
<WhatsAppButton lang={lang} />
<LangSuggest lang={lang} />

<script>
  import '../scripts/reveal';
</script>
