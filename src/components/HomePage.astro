---
import Hero from './Hero.astro';
import LangSuggest from './LangSuggest.astro';
import Nav from './Nav.astro';
import type { Lang } from '../i18n/langs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="conteudo" data-lang={lang}>
  <Hero lang={lang} />
</main>
<LangSuggest lang={lang} />
