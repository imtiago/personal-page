---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Lang } from '../i18n/langs';
import { useTranslations } from '../i18n/t';
import { certifications, courses } from '../content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="certificacoes" class="section grid-bg">
  <div class="container-x">
    <SectionHeading eyebrow={t('certs.eyebrow')} title={t('certs.title')} highlight={t('certs.highlight')} />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        certifications.map((c) => (
          <li data-cert data-reveal class="glass flex flex-col items-center p-6 text-center">
            <span class="mb-4 grid size-14 place-items-center rounded-xl bg-gradient-to-br from-[#0a6ed1] to-[#1f6fd1] font-display text-xs font-bold shadow-lg shadow-primary/30">
              SAP
            </span>
            <h3 class="text-sm font-semibold">{c.title}</h3>
            <p class="mt-1 text-xs text-muted">{c.level[lang]}</p>
            {c.credlyUrl && (
              <a
                data-verify
                href={c.credlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-primary-soft hover:text-text"
              >
                {t('certs.verify')}
                <Icon name="arrow-up-right" size={14} />
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <div class="mt-8" data-reveal>
      <h3 class="eyebrow mb-3">{t('certs.courses')}</h3>
      <ul data-courses class="flex flex-wrap gap-2">
        {courses.map((c) => <li class="chip">{c}</li>)}
      </ul>
    </div>
  </div>
</section>
