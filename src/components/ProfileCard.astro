---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import type { Lang } from '../i18n/langs';
import { useTranslations } from '../i18n/t';
import { profile } from '../content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const stats = [
  { value: 5, suffix: '+', label: t('card.years') },
  { value: profile.stats.sapProjects, suffix: '', label: t('card.projects') },
  { value: profile.stats.certs, suffix: '', label: t('card.certs') },
];
const chips = [
  { label: 'FSM', hl: true },
  { label: 'BTP', hl: true },
  { label: 'SSAM' },
  { label: 'Fiori' },
  { label: 'Kyma' },
];
---

<aside class="glass w-full max-w-sm bg-surface/55 p-6 shadow-2xl shadow-black/30 lg:w-[19rem]" data-reveal>
  <div class="flex items-center gap-4">
    <div class="avatar-ring shrink-0 rounded-full p-[3px]">
      <Image
        src={avatar}
        alt={profile.name}
        width={80}
        height={80}
        densities={[1, 2]}
        loading="eager"
        class="size-20 rounded-full border-[3px] border-bg bg-[#1a2b4a] object-cover"
      />
    </div>
    <div>
      <p class="font-display text-lg font-semibold">{profile.name}</p>
      <p class="text-sm leading-snug text-muted">{t('card.role')} · {profile.location[lang]}</p>
    </div>
  </div>
  <div class="my-5 h-px bg-white/10"></div>
  <dl class="grid grid-cols-3 text-center">
    {
      stats.map((s) => (
        <div class="flex flex-col-reverse">
          <dt class="text-xs text-muted">{s.label}</dt>
          <dd class="font-display text-2xl font-bold text-primary-soft" data-count={s.value} data-suffix={s.suffix}>
            {s.value}
            {s.suffix}
          </dd>
        </div>
      ))
    }
  </dl>
  <ul class="mt-5 flex flex-wrap gap-1.5">
    {chips.map((c) => <li class:list={['chip', { 'chip-hl': c.hl }]}>{c.label}</li>)}
  </ul>
</aside>

<style>
  .avatar-ring {
    background: conic-gradient(from 200deg, #3b9cff, #8b5cf6, #38bdf8, #3b9cff);
    box-shadow: 0 0 40px rgb(59 156 255 / 0.45);
  }
</style>
