---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Lang } from '../i18n/langs';
import { useTranslations } from '../i18n/t';
import { projects } from '../content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = projects.filter((p) => p.featured);
const timeline = projects.filter((p) => !p.featured);
---

<section id="projetos" class="section grid-bg">
  <div class="container-x">
    <SectionHeading eyebrow={t('projects.eyebrow')} title={t('projects.title')} highlight={t('projects.highlight')} />

    <div class="grid gap-4 md:grid-cols-2">
      {
        featured.map((p) => (
          <article
            data-featured
            data-id={p.id}
            data-card
            data-reveal
            class:list={['glass spotlight flex flex-col p-6', { 'border-violet/40': p.kind === 'dev' }]}
          >
            <p class="text-xs text-primary-soft">
              {p.kind === 'dev' && <span class="chip-hl chip mr-2 align-middle">{t('projects.devTag')}</span>}
              {p.period[lang]}
            </p>
            <h3 class="mt-2 font-display text-xl font-semibold">{p.client}</h3>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {p.tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
            <dl class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
              <div>
                <dt class="inline font-semibold text-text">{t('projects.challenge')}: </dt>
                <dd class="inline">{p.challenge[lang]}</dd>
              </div>
              <div>
                <dt class="inline font-semibold text-text">{t('projects.delivery')}: </dt>
                <dd class="inline">{p.delivery[lang]}</dd>
              </div>
              {p.result && (
                <div data-result>
                  <dt class="inline font-semibold text-text">{t('projects.result')}: </dt>
                  <dd class="inline">{p.result[lang]}</dd>
                </div>
              )}
            </dl>
            {p.repoUrl && (
              <a
                href={p.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-1.5 self-start text-sm font-semibold text-primary-soft hover:text-text"
              >
                {t('projects.repo')}
                <Icon name="arrow-up-right" size={16} />
              </a>
            )}
          </article>
        ))
      }
    </div>

    <h3 class="mt-14 mb-6 font-display text-lg font-semibold" data-reveal>{t('projects.timeline')}</h3>
    <ol data-timeline class="timeline space-y-6" data-reveal>
      {
        timeline.map((p) => (
          <li>
            <p>
              <span class="font-display text-base font-semibold">{p.client}</span>
              <span class="text-xs text-primary-soft"> · {p.period[lang]}</span>
            </p>
            <p class="mt-1 text-sm text-muted">{p.delivery[lang]}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding-left: 1.75rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: linear-gradient(var(--color-primary), var(--color-violet));
  }

  .timeline li {
    position: relative;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem + 1px);
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-primary);
  }
</style>
